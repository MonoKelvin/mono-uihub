"use client";

import { useEffect, useRef, useState } from "react";

// Copy this example into the studio as StudioGallery.tsx, then replace this origin.
// Keep it identical to the studio CSP frame-src allowlist and the deployed gallery.
const GALLERY_ORIGIN = "https://ACTUAL-GALLERY.vercel.app";
const STUDIO_ORIGINS = new Set([
  "https://monokelvin.cn",
  "https://www.monokelvin.cn",
]);
const MIN_HEIGHT = 320;
const MAX_HEIGHT = 50_000;
const INITIAL_HEIGHT = 960;

type StudioGalleryProps = {
  lang?: "zh" | "en";
};

export default function StudioGallery({ lang = "zh" }: StudioGalleryProps) {
  const iframeRef = useRef<HTMLIFrameElement>(null);
  const [parentOrigin, setParentOrigin] = useState<string | null>(null);
  const [height, setHeight] = useState(INITIAL_HEIGHT);

  useEffect(() => {
    const origin = window.location.origin;
    if (STUDIO_ORIGINS.has(origin)) setParentOrigin(origin);

    function onMessage(event: MessageEvent<unknown>) {
      if (event.origin !== GALLERY_ORIGIN) return;
      const childWindow = iframeRef.current?.contentWindow;
      if (!childWindow || event.source !== childWindow) return;
      const data = event.data;
      if (typeof data !== "object" || data === null) return;
      if (!("type" in data) || data.type !== "mono-uihub:resize") return;
      if (!("height" in data) || typeof data.height !== "number") return;
      if (!Number.isFinite(data.height)) return;
      if (data.height < MIN_HEIGHT || data.height > MAX_HEIGHT) return;
      setHeight(Math.ceil(data.height));
    }

    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, []);

  const standaloneUrl = new URL("/", GALLERY_ORIGIN);
  standaloneUrl.searchParams.set("lang", lang);
  const embedUrl = new URL("/embed/", GALLERY_ORIGIN);
  embedUrl.searchParams.set("lang", lang);
  if (parentOrigin) embedUrl.searchParams.set("parent", parentOrigin);

  return (
    <section aria-label={lang === "en" ? "UI prototype gallery" : "UI 原型画廊"}>
      {/* Also available when CSP, networking, or the parent allowlist blocks embedding. */}
      <p>
        <a href={standaloneUrl.href} target="_blank" rel="noopener noreferrer">
          {lang === "en" ? "Open gallery in a new tab" : "在新标签页打开画廊"}
        </a>
      </p>
      {parentOrigin ? (
        <iframe
          ref={iframeRef}
          src={embedUrl.href}
          title={lang === "en" ? "mono-uihub UI prototype gallery" : "mono-uihub UI 原型画廊"}
          loading="lazy"
          referrerPolicy="strict-origin-when-cross-origin"
          style={{ display: "block", width: "100%", height, border: 0 }}
        />
      ) : (
        <p role="status">
          {lang === "en"
            ? "Embedding is available on the approved studio domains."
            : "嵌入仅在已授权的 studio 域名上启用。"}
        </p>
      )}
    </section>
  );
}
