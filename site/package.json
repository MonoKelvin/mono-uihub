{
  "name": "mono-uihub-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node ../skills/setup-skills.mjs",
    "dev": "node ../skills/setup-skills.mjs && node scripts/sync-prototypes.mjs && astro dev",
    "build": "node ../skills/setup-skills.mjs && node scripts/sync-prototypes.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:background": "node --test tests/*.dom.mjs",
    "screenshots": "node ../tools/screenshots/capture.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
