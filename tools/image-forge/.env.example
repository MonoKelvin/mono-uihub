#!/usr/bin/env python3 -m doctest -v  # noqa: E501
"""Example .env values for Image Forge.

Copy this file to ``.env`` and fill in your own credentials.
NEVER commit the real ``.env`` — it is in .gitignore.
"""

# OpenAI-compatible endpoint (including /v1 suffix).
#   OpenAI:        https://api.openai.com/v1
#   Grok gateway:  https://api.grok.ai/v1
#   Local/self-host: https://your-gateway.example.com/v1
IMAGE_API_BASE_URL=https://api.openai.com/v1

# Bearer token for your chosen provider.
IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Image model id.
#   OpenAI:        gpt-image-2
#   Grok:          grok-imagine-2  (>= v2 — requires grok-imagine-3 fallback? set below)
#   Third-party:   whatever your gateway exposes
IMAGE_MODEL=gpt-image-2

# Optional: a fallback model used when the primary returns "model not found".
# Comment out / leave empty to disable fallback.
IMAGE_MODEL_FALLBACK=
