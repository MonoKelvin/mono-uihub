# mono-uihub unified local configuration.
# Copy to .env in the repository root. Never commit real credentials.

# Image Forge — OpenAI-compatible image generation / editing API.
# Agnes Image 2.5 Flash: https://www.agnes-ai.com/en/docs/agnes-image-25-flash
IMAGE_API_BASE_URL=https://apihub.agnes-ai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=agnes-image-2.5-flash
IMAGE_MODEL_FALLBACK=

# Optional matte-specific override; defaults to IMAGE_MODEL.
IMAGE_MATTE_MODEL=
# Online image edit output tier: 1K, 2K, 3K or 4K.
IMAGE_MATTE_SIZE=2K
IMAGE_MATTE_TIMEOUT=240
# Offline default: auto (portrait hint -> birefnet-portrait; otherwise birefnet-general).
IMAGE_MATTE_OFFLINE_MODEL=auto
# Set empty to download ONNX models directly from GitHub.
IMAGE_FORGE_GH_PROXY=https://ghfast.top/

# Set to 1 only when the gateway accepts a top-level negative_prompt field.
IMAGE_NEGATIVE_PARAM=
# Optional purify.json override.
PURIFY_PACK=

# Resource Getter — https://pixabay.com/api/docs/
PIXABAY_API_KEY=
STORYSET_MCP_URL=https://storyset-mcp.engdawood.com/mcp

# Optional search APIs. Direct-id access still works without them.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Pixiv: python tools/resource-getter/get.py pixiv-login
# The helper updates PIXIV_REFRESH_TOKEN in the root .env.
PIXIV_REFRESH_TOKEN=

# Optional proxy for Pixiv, model downloads or slow origins.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
