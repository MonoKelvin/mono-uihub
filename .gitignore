# Local OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store

# OS temp
*.tmp
*.log

# Agent session cache & nested worktrees — never version-controlled
.claude/worktrees/
.claude/plans/
.claude/temp/

# Editor
.vscode/
.idea/
*.swp
.workbuddy/

# finesse 构建历史（本地轮换记忆，随每次构建重写）
.finesse/

# Never commit API credentials (e.g. tools/image-forge/qingjiu.env)
*.env

# Image Forge — never commit real credentials
.env
tools/image-forge/.env
tools/resource-getter/.env
tools/resource-getter/.env.local
tools/resource-getter/.cache/
tools/resource-getter/test-output/
# Vendored third-party source (cloned by pixiv-login; never committed)
tools/resource-getter/vendor/pixiv-mcp-server/
__pycache__/

# Image Forge — large matting models fetched on demand (keep vendored u2netp.onnx)
tools/image-forge/models/cache/

temp/

# Gallery build artifacts
site/node_modules/
site/dist/
site/.astro/
site/public/prototypes/
site/public/site/modules/
site/.vercel/
