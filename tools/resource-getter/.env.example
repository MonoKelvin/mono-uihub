# Copy to .env (same directory). The real .env is gitignored.
# Only PIXABAY_API_KEY is needed for the recommended illustration workflow.

# Pixabay — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Storyset MCP (public endpoint; no signup).
STORYSET_MCP_URL=https://storyset-mcp.engdawood.com/mcp

# Pixiv — run `python tools/resource-getter/get.py pixiv-login`.
# The helper clones vendor/pixiv-mcp-server and writes the token here.
# Artwork is user copyright: private reference only.
PIXIV_REFRESH_TOKEN=

# Optional search APIs. Without them, Unsplash/Pexels still work via direct id.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional proxy for Pixiv or slow origins.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
